{
    "name": "iobroker.rainpoint",
    "version": "0.1.1",
    "description": "Control RainPoint / HomGar irrigation devices from ioBroker",
    "author": {
        "name": "Andreas"
    },
    "homepage": "https://github.com/Kuebi7/ioBroker.rainpoint",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "rainpoint",
        "homgar",
        "irrigation",
        "garden",
        "watering"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Kuebi7/ioBroker.rainpoint.git"
    },
    "engines": {
        "node": ">= 20"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.3.2"
    },
    "devDependencies": {
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.3.0",
        "@tsconfig/node20": "^20.1.9",
        "@types/iobroker": "npm:@iobroker/types@^7.1.1",
        "@types/chai": "^4.3.20",
        "@types/chai-as-promised": "^7.1.8",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.0",
        "@types/proxyquire": "^1.3.31",
        "@types/sinon": "^17.0.4",
        "@types/sinon-chai": "^3.2.12",
        "chai": "^4.5.0",
        "chai-as-promised": "^7.1.2",
        "mocha": "^11.7.1",
        "proxyquire": "^2.1.3",
        "rimraf": "^6.1.0",
        "sinon": "^20.0.0",
        "sinon-chai": "^3.7.0",
        "source-map-support": "^0.5.21",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3"
    },
    "main": "build/main.js",
    "files": [
        "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
        "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
        "build/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prebuild": "rimraf build",
        "build": "build-adapter ts",
        "watch": "build-adapter ts --watch",
        "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
        "test:package": "mocha test/package --exit",
        "test:integration": "mocha test/integration --exit",
        "test": "npm run test:ts && npm run test:package",
        "check": "tsc --noEmit",
        "lint": "eslint -c eslint.config.mjs ."
    },
    "bugs": {
        "url": "https://github.com/Kuebi7/ioBroker.rainpoint/issues"
    },
    "readmeFilename": "README.md"
}
